# Local development defaults.
# With this relative path, browser requests go through the Vite proxy:
# /api -> http://localhost:8080 (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Direct-to-backend alternative. This bypasses the Vite proxy and requires
# the backend to allow this frontend origin via APP_CORS_ALLOWED_ORIGINS.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
